# Copie ce fichier en .env.local et remplis les valeurs.

# Adresse du site en ligne (sans / à la fin), utilisée pour le référencement
NEXT_PUBLIC_SITE_URL=https://www.ton-domaine.com

# Clé API Resend : https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Adresse qui reçoit les messages du formulaire
CONTACT_TO_EMAIL=ton-email@exemple.com

# Expéditeur (domaine vérifié dans Resend). Sans domaine vérifié, garde onboarding@resend.dev
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
